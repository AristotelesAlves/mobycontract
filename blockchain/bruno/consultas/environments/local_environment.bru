name: local_environment
variables:
  - name: base_url
    value: 'http://localhost:8000/blockchain'
    description: Registry service pela borda do nginx (o prefixo /blockchain e removido pelo proxy)
  - name: apiKey
    value: 'chave-local-de-desenvolvimento'
    description: Chave de API (header x-api-key). /saude e publica e dispensa a chave
  - name: contratoId
    value: 'CT-2026-001'
    description: Identificador do contrato no ledger
