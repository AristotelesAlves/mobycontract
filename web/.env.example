# Copie este arquivo para .env.local para configurar o desenvolvimento local.

# URL da API acessada pelo servidor Next.js.
BASE_URI_API=http://localhost:8000/api/v1

# URL usada pelo navegador; /api/v1 utiliza o proxy configurado no Next.js.
NEXT_PUBLIC_BASE_URI_API=/api/v1

# Opcional: caminho de um Chrome/Chromium instalado para gerar PDFs.
# Quando omitido, o Puppeteer utiliza seu navegador padrão.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
