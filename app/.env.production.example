APP_NAME=MobyContract
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mobycontract.example
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Fortaleza
AUTH_ACCESS_COOKIE_MINUTES=60
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mobycontract
DB_USERNAME=
DB_PASSWORD=
DB_SCHEMA=public
DB_SSLMODE=require
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=mobycontract

REDIS_CLIENT=phpredis
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=0
CACHE_STORE=redis
QUEUE_CONNECTION=redis

CORS_ORIGINS=https://mobycontract.example
BLOCKCHAIN_REGISTRY_URL=http://registry:4000
BLOCKCHAIN_API_KEY=
BLOCKCHAIN_REGISTRADOR=App\\Shared\\Infrastructure\\Blockchain\\MobyLedgerClient

# Nunca reutilize as chaves, senhas ou o estado da rede de desenvolvimento.
# Injete estes valores por Docker secrets, cofre de segredos ou plataforma de deploy.
