APP_NAME=MobyContract
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=mobycontract
DB_DATABASE_TESTE=mobycontract_teste
DB_USERNAME=mobycontract
DB_PASSWORD=
DB_SCHEMA=public
POSTGRES_USER=mobycontract
POSTGRES_PASSWORD=
POSTGRES_DB=mobycontract

REDIS_CLIENT=phpredis
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=0
REDIS_CACHE_PREFIX=mobycontract:cache:
# Limite do Redis de cache: fixado em 256mb no infra/docker-compose.yml (política allkeys-lru).

REDIS_QUEUE_HOST=redis-queue
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=0
REDIS_QUEUE_PREFIX=mobycontract:fila:
# Limite do Redis de fila: fixado em 512mb no infra/docker-compose.yml (política noeviction).

CACHE_STORE=redis
CACHE_PREFIX=mobycontract
QUEUE_CONNECTION=redis

SESSION_DRIVER=array
DB_SSLMODE=prefer
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci

CORS_ORIGINS=http://localhost:3000

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=nao-responde@mobycontract.test
MAIL_FROM_NAME="${APP_NAME}"

VISTORIA_LINKS_VALIDADE_DIAS=7
VISTORIA_TENTATIVAS_SENHA=5
CONTRATOS_DIA_VENCIMENTO_PADRAO=5
CONTRATOS_MULTA_RESCISAO_PADRAO=3
CONTRATOS_PRAZO_VIGENCIA_MESES=12
INQUILINOS_IDADE_MINIMA=18
INQUILINOS_LIMITE_COMPROMISSEO_SEGURO=30
INQUILINOS_LIMITE_ALERTA_COMPROMISSO=35
LISTAGEM_ITENS_POR_PAGINA=20
PAINEL_MOVIMENTACOES_EXIBIDAS=5
MODELOS_LARGURA_MAXIMA_IMAGEM=900
MODELOS_QUALIDADE_IMAGEM=0.7
